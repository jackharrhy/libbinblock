[configuration]

entry_symbol = "binblock_godot_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://bin/libbinblock_godot.dylib"
macos.release = "res://bin/libbinblock_godot.dylib"
linux.debug.x86_64 = "res://bin/libbinblock_godot.so"
linux.release.x86_64 = "res://bin/libbinblock_godot.so"
windows.debug.x86_64 = "res://bin/binblock_godot.dll"
windows.release.x86_64 = "res://bin/binblock_godot.dll"
