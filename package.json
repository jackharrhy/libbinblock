{
  "name": "bingen",
  "version": "0.1.0",
  "private": true,
  "description": "Build raster image collections from composable JSON recipes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackharrhy/bingen.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "analyze:duplicates": "tsx scripts/analyze-duplicates.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "canvas": "^3.2.0",
    "esbuild": "^0.27.2",
    "jszip": "^3.10.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
